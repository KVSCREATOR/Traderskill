# Copy to tradeskill.env (same folder) and edit. tradeskill.env is NOT uploaded to GitHub.

# Password for the portal sign-in page (8+ characters). Required on the NAS.
PORTAL_PASSWORD=change-me-please

# The address you open the portal at: DSM's HTTPS reverse proxy (see NAS.md step 4).
# Plain http 8765 is only reachable on the NAS itself.
PUBLIC_URL=https://192.168.1.200:8766

# Telegram bot token from @BotFather (optional; see NAS.md "Telegram notifications").
TELEGRAM_BOT_TOKEN=
