# Copy to tradeskill.env (same folder) and edit. tradeskill.env is NOT uploaded to GitHub.

# Password for the portal sign-in page (8+ characters). Required on the NAS.
PORTAL_PASSWORD=change-me-please

# The address you open the portal at. Zerodha sends your browser back here after login.
# Tailscale (works at home and outside):  http://<NAS tailscale IP>:8765
# Home network only:                       http://192.168.1.200:8765
PUBLIC_URL=http://192.168.1.200:8765
